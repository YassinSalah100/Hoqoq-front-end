# Backend API base URL. Defaults to http://localhost:3006/api (matches the
# `api` service in `hoqoq backend/Hoqooq/docker-compose.yml`, PORT=3006).
# If you run the backend locally with `npm run start:dev` instead of Docker,
# it uses the backend's .env PORT (3000 by default) — set this to match.
VITE_API_BASE_URL=http://localhost:3006/api
